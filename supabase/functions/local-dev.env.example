# Copy this file to local-dev.env for `pnpm functions:serve`.
# These values are for local Supabase only, never for a hosted project.
APP_URL=http://127.0.0.1:3000
PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1
CRON_SECRET=local-only-cron-secret
UNSUBSCRIBE_SECRET=local-only-unsubscribe-secret-0000000000
MAILPIT_URL=http://inbucket:8025
REMINDERS_ALLOW_NOW=1
SITE_URL=http://127.0.0.1:3000
EMAIL_FROM=Noor <noor@example.com>
# Leave empty so local messages are captured by Mailpit, not sent externally.
RESEND_API_KEY=
# Optional for local push testing. Leave blank to keep push disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:local@example.invalid
PUSH_MOCK=1
ACCOUNT_NOTICE_SECRET=local-only-account-notice-secret-0000000000
EMAIL_HASH_SECRET=local-only-email-hash-secret-000000000000
AI_ADMIN_SECRET=local-only-ai-admin-secret-00000000000000
# Optional free-tier AI providers for local testing. Leave empty to disable them.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Optional retrieval and usage limits; these are the application defaults.
ASK_NOOR_THRESHOLD=0.8
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_CAP=500
