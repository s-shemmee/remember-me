{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext", "webworker"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": ["sw.ts", "../features/pwa/*.ts"],
  "exclude": ["../features/pwa/*.test.ts"]
}
