# Copy to .env.local for the Next.js app. These defaults point to local Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
ACCOUNT_NOTICE_SECRET=local-only-account-notice-secret-0000000000

# Optional Noor help; leave disabled for the default local setup.
AI_ENABLED=false
NOOR_CHAT_ENABLED=false
NOTIFICATIONS_INBOX_ENABLED=false
AI_MOCK=1

# Optional local utility and build settings.
SUPABASE_URL=http://127.0.0.1:54321
SITE_URL=http://localhost:3000
AI_ADMIN_SECRET=
# Optional: leave blank to disable Sentry; use your own project DSN if enabled.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
LHCI_URL=

# Do not put Supabase secret keys, mail-provider credentials, AI-provider
# credentials, or private VAPID keys here. Configure them server-side only
# when enabling those services. Local email is captured by Mailpit.
